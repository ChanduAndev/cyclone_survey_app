                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:padding="4dp"
                    android:text="Pole Height* :"
                    android:textColor="@color/red" />


                <Spinner
                    android:id="@+id/sp_abc_poleheight"
