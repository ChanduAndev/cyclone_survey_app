<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/adapter_border"
    android:layout_marginLeft="20dp"
    android:layout_marginRight="20dp"
    android:layout_marginTop="5dp"
    >

    <TextView
        android:id="@+id/header_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/amaranth_bold"
        android:gravity="start"
        android:layout_marginTop="10dp"
        android:paddingVertical="2dp"
        android:paddingHorizontal="10dp"
        android:text=""
        android:visibility="gone"
        android:textAllCaps="true"
        android:textColor="@color/colorPrimary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/line_extension_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="2dp"
        android:paddingHorizontal="10dp"
        android:fontFamily="@font/inter"
        android:gravity="start"
        android:text=""
        android:visibility="gone"
        android:textColor="@color/ui_black_color"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/new_color"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        android:layout_marginBottom="5dp"
        />

    <TextView
        android:id="@+id/header_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/amaranth_bold"
        android:gravity="start"
        android:paddingVertical="2dp"
        android:paddingHorizontal="10dp"
        android:text=""
        android:visibility="gone"
        android:textAllCaps="true"
        android:textColor="@color/colorPrimary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/new_bay_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="2dp"
        android:paddingHorizontal="10dp"
        android:fontFamily="@font/inter"
        android:gravity="start"
        android:text=""
        android:visibility="gone"
        android:textColor="@color/ui_black_color"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone"
        android:background="@color/new_color"
        android:layout_marginTop="10dp"
        />


    <TextView
        android:id="@+id/back_to_home"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/button_background"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:layout_gravity="center"
        android:paddingVertical="10dp"
        android:paddingHorizontal="70dp"
        android:text="OKAY"
        android:textAllCaps="true"
        android:backgroundTint="@color/colorPrimary"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />



</LinearLayout>