<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/mainLayout"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/loader_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="PLEASE WAIT..."
            android:textColor="@color/red1"
            android:textSize="16dp" />


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layout_bottom_version"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/two_side_square_border"
            android:padding="5dp">


            <RelativeLayout
                android:id="@+id/back_layout"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_alignParentLeft="true"
                android:layout_centerInParent="true"
                android:layout_marginLeft="15dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/round_boarder">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_arrow_back_black_24dp"
                    android:tint="@color/new_color" />


            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_toLeftOf="@+id/close_layout"
                android:layout_toRightOf="@id/back_layout"
                android:background="@drawable/btn_rounded_primary"
                android:backgroundTint="@color/new_color">

                <TextView
                    android:id="@+id/home_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/inter"
                    android:paddingTop="5dp"
                    android:text="Edit DTR Particulurs"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/close_layout"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_alignParentRight="true"
                android:layout_centerInParent="true"
                android:layout_marginRight="15dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/round_boarder">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_baseline_close_24"
                    android:tint="@color/new_color" />

            </RelativeLayout>
        </RelativeLayout>


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="visible">


                <LinearLayout
                    android:id="@+id/layout_dtr_survey"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_marginTop="35dp"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/inter"
                        android:text="DTR Survey Type*"
                        android:textColor="@color/colorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/sp_dtr_survey_11"
                        android:layout_width="fill_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/ddimg"
                        android:entries="@array/dtr_survey_type" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/existing_main_lt_layout_11kv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_dtrstrcuture_code"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/size_5dp"
                        android:fontFamily="@font/inter"
                        android:text="Existing DTR Structure Code :"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold|italic" />

                    <TextView
                        android:id="@+id/existing_dtr_structure_code_11kv"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_gravity="center|left"
                        android:layout_margin="5dp"
                        android:background="@drawable/distance_border"
                        android:gravity="center|left"
                        android:hint="Existing Select DTR Structure Code"
                        android:padding="5dp"
                        android:textColor="@color/black" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/proposed_layout_dtr_details_11kv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_15dp"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/inter"
                        android:text="----Proposed DTR Details----"
                        android:textColor="@color/colorAccent"
                        android:textSize="15sp"
                        android:textStyle="bold" />


                    <LinearLayout
                        android:id="@+id/layout_dtr_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:background="@drawable/distance_boarder_2"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:visibility="visible">
                        <!-- Title -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="-----DTR Particulars-----"
                            android:textStyle="bold" />
                        <!-- Details Layout -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:orientation="vertical">
                            <!-- Row 1: Phase & Capacity -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Phase :"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tv_dtr_phase"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    tools:text="III"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Capacity :"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tv_dtr_capacity"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    tools:text="100 KVA"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                            <!-- Row 2: Sl.No -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="5dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Sl.No :"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tv_dtr_slno"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="3"
                                    tools:text="14257"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                            <!-- Row 3: Make -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="5dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Make :"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tv_dtr_make"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="3"
                                    tools:text="Transctin hhahhahhaha"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                            <!-- Row 4: Location -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:paddingVertical="5dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Location :"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tv_dtr_location_name"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="3"
                                    tools:text="WATER TANK"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_edit_dtr_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:gravity="end"
                        android:paddingEnd="10dp"
                        android:text="Edit DTR DETAILS"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/existing_dtr_particulars_11kv"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_marginTop="15dp"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <LinearLayout
                            android:id="@+id/existing_dtr_layout_dtr_phase_11kv"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:layout_marginTop="15dp"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <TextView
                                android:id="@+id/dtr_phase_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter"
                                android:text="Existing DTR Phase*"
                                android:textColor="@color/colorPrimary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/existing_dtr_sp_dtr_phase_11"
                                android:layout_width="fill_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/ddimg" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/existing_dtr_layout_dtr_capacity"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:layout_marginTop="15dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/dtr_capacity_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter"
                                android:text="Existing DTR Capacity*"
                                android:textColor="@color/colorPrimary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/existing_dtr_sp_dtr_capacity_phase1_11"
                                android:layout_width="fill_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/ddimg"
                                android:entries="@array/dtr_phase1_capacity_11kv"
                                android:visibility="gone" />

                            <Spinner
                                android:id="@+id/existing_dtr_sp_dtr_capacity_phase2_11"
                                android:layout_width="fill_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/ddimg"
                                android:entries="@array/dtr_phase2_capacity_11kv"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layout_dtr_material"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:layout_marginTop="15dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tv_sp_pole_desc_11"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter"
                                android:text="DTR Material"
                                android:textColor="@color/colorPrimary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/sp_dtr_material_11"
                                android:layout_width="fill_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/ddimg" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/existing_dtr_layout_dtr_location_11kv"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:layout_marginTop="15dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/dtr_location_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter"
                                android:text="Existing DTR Location*"
                                android:textColor="@color/colorPrimary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/existing_dtr_dtr_location_name"
                                android:layout_width="fill_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/distance_boarder_2"
                                android:hint="Enter Existing DTR Location Name"
                                android:inputType="textCapCharacters"
                                android:maxLength="150"
                                android:padding="10dp"
                                android:singleLine="true"
                                android:textSize="15dp"
                                tools:text="hello" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/existing_dtr_layout_dtr_make_11kv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/dtr_make_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter"
                                android:text="Existing DTR Make*"
                                android:textColor="@color/colorPrimary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <AutoCompleteTextView
                                android:id="@+id/actv_existing_dtr_make"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/ddimg"
                                android:completionThreshold="1"
                                android:hint="Search DTR Make"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:textSize="14sp" />

                        </LinearLayout>

<!--                        <LinearLayout-->
<!--                            android:id="@+id/existing_dtr_layout_dtr_make_11kv"-->
<!--                            android:layout_width="fill_parent"-->
<!--                            android:layout_height="fill_parent"-->
<!--                            android:layout_marginTop="15dp"-->
<!--                            android:orientation="vertical"-->
<!--                            android:visibility="gone">-->

<!--                            <TextView-->
<!--                                android:id="@+id/dtr_make_1"-->
<!--                                android:layout_width="wrap_content"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:fontFamily="@font/inter"-->
<!--                                android:text="Existing DTR Make*"-->
<!--                                android:textColor="@color/colorPrimary"-->
<!--                                android:textSize="15sp"-->
<!--                                android:textStyle="bold" />-->


<!--                            <Spinner-->
<!--                                android:id="@+id/sp_existing_dtr_et_dtr_make"-->
<!--                                android:layout_width="fill_parent"-->
<!--                                android:layout_height="40dp"-->
<!--                                android:layout_marginTop="8dp"-->
<!--                                android:background="@drawable/ddimg"-->
<!--                                android:entries="@array/dtr_apartment"-->
<!--                                android:visibility="visible" />-->


<!--                        </LinearLayout>-->

                        <LinearLayout
                            android:id="@+id/existing_dtr_layout_dtr_sl_no_11kv"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:layout_marginTop="15dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/dtr_sl_no_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter"
                                android:text="Existing DTR Serial No*"
                                android:textColor="@color/colorPrimary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/existing_dtr_et_dtr_sl_no"
                                android:layout_width="fill_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/distance_boarder_2"
                                android:hint="Enter Existing Serial number"
                                android:maxLength="150"
                                android:padding="10dp"
                                android:textSize="15dp"
                                tools:text="hello" />
                        </LinearLayout>
                    </LinearLayout>
                    >


                </LinearLayout>

                <Button
                    android:id="@+id/btn_update"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/round_button"
                    android:backgroundTint="@color/colorPrimary"
                    android:fontFamily="@font/inter"
                    android:padding="4dp"
                    android:text="Update"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>


        </ScrollView>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/layout_bottom_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/two_sides_rounded_border_up"
        android:backgroundTint="@color/light_gray_clor_2"
        android:padding="3dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/inter"
            android:text="@string/powerby"
            android:textColor="@color/ui_black_color"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>



</RelativeLayout>