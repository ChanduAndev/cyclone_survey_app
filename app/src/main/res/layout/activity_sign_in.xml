<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:padding="24dp">

    <!-- App Logo -->
    <RelativeLayout
        android:id="@+id/imgLogo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp"
        android:background="@drawable/round_boarder"
        android:backgroundTint="#DBE4FF">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerInParent="true"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:src="@drawable/new_logo" />
    </RelativeLayout>


    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/imgLogo"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/inter"
        android:text="GIS SURVEY"
        android:textColor="@color/colorPrimary"
        android:textSize="40sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/txtSubTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:text="Eastern Power Distribution Company of AP"
        android:textColor="#7A7A7A"
        android:textSize="14sp" />

    <!-- Username Label -->
    <TextView
        android:id="@+id/lblUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtSubTitle"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/inter"
        android:text="Username"
        android:textColor="#000000"
        android:textStyle="bold" />

    <!-- Username Field -->
    <EditText
        android:id="@+id/ed_user_id"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_below="@id/lblUsername"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edittext_round"
        android:fontFamily="@font/inter"
        android:hint="Enter your username"
        android:inputType="text"
        android:textColor="@color/ui_black_color"
        android:paddingStart="20dp"
        android:textSize="14sp"
        tools:ignore="RtlSymmetry" />

    <!-- Password Label -->
    <TextView
        android:id="@+id/lblPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/ed_user_id"
        android:layout_marginTop="20dp"
        android:elevation="1dp"
        android:fontFamily="@font/inter"
        android:text="Password"
        android:textColor="#000000"
        android:textStyle="bold" />

    <!-- Password Container -->
    <RelativeLayout
        android:id="@+id/passwordContainer"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_below="@id/lblPassword"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_edittext_round">

        <EditText
            android:id="@+id/ed_password"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toStartOf="@id/imgTogglePassword"
            android:background="@android:color/transparent"
            android:fontFamily="@font/inter"
            android:hint="Enter your password"
            android:textColor="@color/ui_black_color"
            android:inputType="textPassword"
            android:paddingStart="20dp"
            android:paddingEnd="10dp"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/imgTogglePassword"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_eye_closed" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tv_login_as"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login as"
        android:visibility="gone"
        android:layout_below="@id/passwordContainer"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:layout_marginTop="10dp"/>
    <!-- Submit Button -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_login_as"
        android:id="@+id/employeeLoginContainer"
        android:gravity="center"
        android:orientation="vertical">

        <CheckBox
            android:id="@+id/checkBox_bill_reader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Login as a bill reader"
            android:textSize="14sp"
            android:visibility="visible"
            android:textColor="@color/ui_black_color"/>

        <TextView
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit"
            android:textAllCaps="false"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:layout_marginTop="10dp"
            android:padding="8dp"
            android:textStyle="bold"
            android:background="@drawable/button_background"
            android:fontFamily="@font/inter"
            app:backgroundTint="#2B7CEE"
            app:cornerRadius="12dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/employeeLoginContainer"
        android:gravity="center"
        android:visibility="gone"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btn_login_bill_reader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Bill Reader"
            android:textAllCaps="false"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:padding="8dp"
            android:textStyle="bold"
            android:background="@drawable/button_background"
            android:fontFamily="@font/inter"
            app:backgroundTint="#2B7CEE"
            app:cornerRadius="12dp"/>

        <ProgressBar
            android:id="@+id/loader_bill_reader"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="32dp"
            android:indeterminateTint="@color/colorPrimary"
            android:progressTint="@color/colorPrimary"
            android:visibility="gone" />


    </LinearLayout>

    <ProgressBar
        android:id="@+id/loader"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_centerHorizontal="true"
        android:indeterminateTint="@color/colorPrimary"
        android:layout_centerInParent="true"
        android:progressTint="@color/colorPrimary"
        android:visibility="gone" />

    <!-- Footer -->
    <TextView
        android:id="@+id/txtFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        android:text="@string/powerby"
        android:textColor="@color/light_gray_clor"
        android:textSize="12sp" />





</RelativeLayout>
