            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:text="RMU Make* :"
                android:textColor="@color/black" />

            <Spinner
                android:id="@+id/sp_rmu_make"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_spinner_field"
                android:entries="@array/rmu_make" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lyt_underpolestructure"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:text="Type Of Structure* :"
                android:textColor="@color/black" />

            <Spinner
                android:id="@+id/sp__underpolestructure"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_spinner_field"
                android:entries="@array/undergpole_structure" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lyt_ugpole"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:padding="4dp"
                    android:text="Pole Type* :"
                    android:textColor="@color/black" />

                <Spinner
                    android:id="@+id/sp_ugpoletype"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_spinner_field"
                    android:entries="@array/ugpole_type" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:padding="4dp"
                    android:text="Pole Height* :"
                    android:textColor="@color/black" />


                <Spinner
                    android:id="@+id/sp_ugpoleheight"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_spinner_field"
                    android:entries="@array/pole_height" />
            </LinearLayout>

            <!--    <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:padding="4dp"
                        android:text="Strut/Stay details* :"
                        android:textColor="@color/black" />

                    <Spinner
                        android:id="@+id/sp_ug_struct_stay_detailes"
                        android:layout_width="fill_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_spinner_field"
                        android:entries="@array/ug_struct_stay" />

                </LinearLayout>-->

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:padding="4dp"
                    android:text="PoleSupport* :"
                    android:textColor="@color/black" />

                <Spinner
                    android:id="@+id/sp_ugpolesupport"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_spinner_field"
                    android:entries="@array/ugpole_support" />
            </LinearLayout>


        </LinearLayout>
        <!--<LinearLayout
            android:id="@+id/lyt_ugssname"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:orientation="vertical">
            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:text="SS Name* :"
                android:textColor="@color/black"/>

            <Spinner
                android:id="@+id/sp_ugssname"
                android:layout_width="fill_parent"
