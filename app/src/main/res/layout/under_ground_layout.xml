                android:textColor="@color/black" />
            <!--Straight Through Joint/RMU-->
            <Spinner
                android:id="@+id/sp_straight_rmu"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_spinner_field"
                android:entries="@array/straight_rmu" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lay_ug_line_capacitor"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:text="Line Capacitor Work Condition :"
                android:textColor="@color/black" />

            <Spinner
                android:id="@+id/sp_ug_line_capacitor"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_spinner_field"
                android:entries="@array/ug_line_capacitor" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lay_ug_auto_reclosure"
