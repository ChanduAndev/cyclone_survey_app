        <LinearLayout
            android:id="@+id/lay_ug_dtr_pole_main"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:padding="4dp"
                    android:text="Section Name :"
                    android:textColor="@color/black" />

                <Spinner
                    android:id="@+id/sp_ug_section_name_dtr_pole"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_spinner_field" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:padding="4dp"
                    android:text="DTR Structure:"
                    android:textColor="@color/black" />

                <AutoCompleteTextView
                    android:id="@+id/auto_ug_dtr_structure_dtr_pole"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:padding="4dp"
                    android:text="DTR Structure Type :"
                    android:textColor="@color/black" />

                <Spinner
                    android:id="@+id/sp_ug_dtr_structure_type_dtr_pole"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_spinner_field"
                    android:entries="@array/dtr_structure_type_dtr_pole" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:padding="4dp"
                    android:text="Is DTR available ?:"
                    android:textColor="@color/black" />

                <Spinner
                    android:id="@+id/sp_ug_is_dtr_avalabile"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_spinner_field"
                    android:entries="@array/oh_is_dtr_avalable" />
            </LinearLayout>

            <LinearLayout
