<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6E5E5"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header -->
    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_gradient"
        android:padding="10dp">

        <ImageView
            android:id="@+id/layout_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back_black_24dp"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/home_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/layout_back"
            android:layout_marginStart="10dp"
            android:layout_centerVertical="true"
            android:fontFamily="@font/inter"
            android:text="LT Cyclone Rectification"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout_lt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:tabTextAppearance="@style/CustomTabTextAppearance"
        app:tabBackground="@drawable/tab_background_selector"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabTextColor="@color/black" />

    <!-- Tab Content -->
    <FrameLayout
        android:id="@+id/tab_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Survey Tab -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_33"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp"
            android:visibility="visible" />

        <!-- Rectification Tab -->
        <ScrollView
            android:id="@+id/direct_rectification_scroll_lt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <include
                layout="@layout/layout_direct_rectification_lt" />

        </ScrollView>

    </FrameLayout>

</LinearLayout>
