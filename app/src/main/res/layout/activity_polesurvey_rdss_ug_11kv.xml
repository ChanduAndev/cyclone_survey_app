<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainRDSSUg11KvActivity">

    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/toolbar"/>
        <LinearLayout
            android:id="@+id/lay_main"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:background="@drawable/background_1"
            android:orientation="vertical"
            android:padding="2dp"
            android:layout_below="@+id/toolbar">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:orientation="vertical"
                    android:padding="5dp">

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        android:gravity="center"
                        android:text=" 11Kv Feeder "
                        android:textColor="@color/red"
                        android:textStyle="bold|italic" />

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="1">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="6dp"
                            android:layout_weight="0.5"
                            android:text="Surveyed Poles"
                            android:textColor="@color/red"
                            android:textStyle="bold|italic" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:layout_weight="0.1"
                            android:text=":"
                            android:textColor="@color/red" />

                        <TextView
                            android:id="@+id/tv_surveyedpole"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:layout_weight="0.5"
                            android:text="0"
                            android:textStyle="bold|italic" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lyt_surveytype"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:text=" Survey Type :"
                            android:textColor="@color/red"
                            android:textStyle="bold|italic" />

                        <Spinner
                            android:id="@+id/sp_loadmap"
                            android:layout_width="fill_parent"
                            android:layout_height="40dp"
                            android:layout_margin="4dp"
                            android:background="@drawable/ddimg"
                            android:entries="@array/load_map" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lyt_tapingpoint"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:text="Select Taping Point Location:"
                            android:textColor="@color/red"
                            android:textStyle="bold|italic" />

                        <Spinner
                            android:id="@+id/sp_tappingpoint"
                            android:layout_width="fill_parent"
                            android:layout_height="40dp"
                            android:layout_margin="4dp"
                            android:background="@drawable/ddimg"
                            android:entries="@array/load_map" />
                    </LinearLayout>

                    <!-- <com.google.android.material.textfield.TextInputLayout
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content">

                         <com.google.android.material.textfield.TextInputEditText
                             android:id="@+id/edt_frompole"
                             android:layout_width="match_parent"
                             android:layout_height="wrap_content"
                             android:inputType="number"
                             android:maxLength="3"
                             android:hint="@string/from_pole"/>

                     </com.google.android.material.textfield.TextInputLayout>
                     <com.google.android.material.textfield.TextInputLayout
                         android:layout_width="match_parent"
                         android:layout_height="wrap_content">

                         <com.google.android.material.textfield.TextInputEditText
                             android:id="@+id/edt_topole"
                             android:layout_width="match_parent"
                             android:layout_height="wrap_content"
                             android:inputType="number"
                             android:maxLength="3"
                             android:hint="@string/to_pole"/>

                     </com.google.android.material.textfield.TextInputLayout>-->


                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lay_main"
            android:id="@+id/btn_layout"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="10dp">

            <Button
                android:id="@+id/btn_polenext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="10dp"
                android:background="@drawable/button_round_corner"
                android:gravity="center"
                android:text="Next"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btn_taping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="10dp"
                android:background="@drawable/button_round_corner"
                android:gravity="center"
                android:text="Next"
                android:textAllCaps="false"
                android:textColor="@color/white" />
        </LinearLayout>
        <Button
            android:id="@+id/btn_add_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/btn_layout"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center"
            android:layout_marginStart="10dp"
            android:visibility="gone"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/button_round_corner"
            android:gravity="center"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:text="Add Tapping Point For Spur Line"
            android:textAllCaps="false"
            android:textColor="@color/white" />
        <include layout="@layout/footer"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>