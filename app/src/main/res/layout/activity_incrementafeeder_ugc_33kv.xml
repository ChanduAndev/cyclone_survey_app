<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivityUG33KV">
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="10dp">
    <TextView
        android:id="@+id/tv_subname"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text=" SS Name :"
        android:textColor="@color/red"
        android:layout_marginTop="10dp"
        android:textStyle="bold|italic"/>
    <Spinner
        android:id="@+id/sp_ssname"
        android:layout_width="fill_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/ddimg"
        android:entries="@array/ss_name" />
        <TextView
            android:id="@+id/tv_federname"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text=" Feeder Name :"
            android:textColor="@color/red"
            android:layout_marginTop="10dp"
            android:textStyle="bold|italic"/>
        <Spinner
            android:id="@+id/sp_feedername"
            android:layout_width="fill_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/ddimg" />
        <TextView
            android:id="@+id/tv_workorder"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text=" Work Order Number :"
            android:textColor="@color/red"
            android:layout_marginTop="10dp"
            android:textStyle="bold|italic"/>
        <Spinner
            android:id="@+id/sp_workorder"
            android:layout_width="fill_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/ddimg" />

