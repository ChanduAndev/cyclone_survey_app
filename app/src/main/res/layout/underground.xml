<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lyt_underground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:orientation="vertical">


    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:padding="4dp"
            android:text="Is End Pole* :"
            android:textColor="@color/red" />

        <Spinner
            android:id="@+id/sp_ug_isendpole"
            android:layout_width="fill_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_spinner_field"
            android:entries="@array/is_endpole" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:padding="4dp"
            android:text="Is WO Survey Completed ? * :"
            android:textColor="@color/red" />

        <Spinner
            android:id="@+id/sp_ltug_wosurveycompleted"
            android:layout_width="fill_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_spinner_field"
            android:entries="@array/is_survey_complete" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:padding="4dp"
            android:text="Tapping Point* :"
            android:textColor="@color/red" />

        <Spinner
            android:id="@+id/sp_ug_tapping_point"
            android:layout_width="fill_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_spinner_field"
            android:entries="@array/ug_tapping_point" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ug_tappingpoint"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:padding="4dp"
            android:text="No of Spur Lines* :"
            android:textColor="@color/red" />

        <Spinner
            android:id="@+id/sp_ug_notapping_point"
            android:layout_width="fill_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_spinner_field"
            android:entries="@array/ug_notapping_point" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_ug_tappinglocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Tapping Location Name"
                android:inputType="text"
                android:maxLength="100" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:padding="4dp"
            android:text="Cable Size* :"
            android:textColor="@color/red" />

        <Spinner
            android:id="@+id/sp_ug_cablesize"
            android:layout_width="fill_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_spinner_field"
            android:entries="@array/ug_cablesize" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:padding="4dp"
            android:text="No. of Cables* :"
            android:textColor="@color/red" />

        <Spinner
            android:id="@+id/sp_ug_nocable"
            android:layout_width="fill_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_spinner_field"
            android:entries="@array/ug_no_cables" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:padding="4dp"
            android:text="Location Type* :"
            android:textColor="@color/red" />

        <Spinner
            android:id="@+id/sp_ug_locationtype"
            android:layout_width="fill_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_spinner_field"
            android:entries="@array/ug_locationtype" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lay_ug_dtr_pole_dtr_meter_avilable"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:padding="4dp"
            android:text="DTR Meter Available*"
            android:textColor="@color/red" />

        <Spinner
            android:id="@+id/sp_ug_dtr_pole_dtr_meter_avilable"
            android:layout_width="fill_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_spinner_field"
            android:entries="@array/ug_dtr_meter_avilable" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lay_ug_dtr_pole_no_of_meter"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:padding="4dp"
            android:text="No Of Meters*"
            android:textColor="@color/red" />

        <Spinner
            android:id="@+id/sp_ug_dtr_pole_no_of_meters"
            android:layout_width="fill_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_spinner_field"
            android:entries="@array/ug_no_of_meters" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ug_servicepiller"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:padding="4dp"
            android:text="Service Pillar Type* :"
            android:textColor="@color/red" />

        <Spinner
            android:id="@+id/sp_ug_servicepiller_type"
            android:layout_width="fill_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_spinner_field"
            android:entries="@array/ug_servicepiller" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ug_poletype"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:text="Pole Type* :"
                android:textColor="@color/red" />

            <Spinner
                android:id="@+id/sp_ug_poletype"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_spinner_field"
                android:entries="@array/ug_poletype" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:text="Pole Height* :"
                android:textColor="@color/red" />

            <Spinner
                android:id="@+id/sp_ug_poleheight"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_spinner_field"
                android:entries="@array/oh_poletypehite"

                />
            <!-- android:entries="@array/oh_poletypehite"-->
        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:text="Pole Support* :"
                android:textColor="@color/red" />

            <Spinner
                android:id="@+id/sp_ug_polesupport"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_spinner_field"
                android:entries="@array/ug_polesupport" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyt_ug_feederpiller"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:padding="4dp"
            android:text="Feeder Pillar Outgoing Circuits* :"
            android:textColor="@color/red" />

        <Spinner
            android:id="@+id/sp_ug_feedepiller_outg_circuits"
            android:layout_width="fill_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_spinner_field"
            android:entries="@array/ug_feedepiller_outg_circuits" />
    </LinearLayout>




    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_ug_pole_paintingcode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Pole Painting Code"
                android:inputType="text"
                android:maxLength="100" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_ug_remarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Remarks"
                android:inputType="text"
                android:maxLength="100" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>


</LinearLayout>