<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit Survey"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search by Pole No"
        android:textSize="18sp"
        android:layout_marginTop="20dp"
        android:layout_gravity="center"
        android:textColor="@color/lightGrey"
        android:gravity="start"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_15dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etPoleNo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="12dp"
            android:background="@drawable/bg_spinner_field"
            android:hint="Enter pole number"
            android:inputType="number"
            android:singleLine="true" />

        <TextView
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search"
            android:textAllCaps="false"
            android:padding="10dp"
            android:background="@drawable/bg_spinner_field"
            android:backgroundTint="@color/ui_new_color"
            android:textColor="@color/white"
            android:layout_marginStart="8dp" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginVertical="16dp">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#AAAAAA" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  OR  "
            android:textColor="#AAAAAA" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#AAAAAA" />
    </LinearLayout>


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Load nearby poles"
        android:textSize="18sp"
        android:layout_gravity="center"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:gravity="start"/>


    <TextView
        android:id="@+id/btnLoadNearby"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Load poles nearby 500m"
        android:textAllCaps="false"
        android:padding="15dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="@color/ui_new_color"
        android:layout_marginTop="@dimen/size_10dp"
        android:background="@drawable/bg_work_involvements"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Note: User must be at the location to load the nearby poles/locations"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:textColor="@color/redred"
        />

</LinearLayout>
