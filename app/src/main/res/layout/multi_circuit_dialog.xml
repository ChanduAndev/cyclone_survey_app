<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/button_background"
    android:backgroundTint="@color/white"
    android:padding="10dp"
    android:layout_marginLeft="20dp"
    android:layout_marginRight="20dp"
    >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:text="MULTI CIRCUIT !!"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="25sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:id="@+id/description"
                android:visibility="gone"
                android:text="Choose Voltage Level"
                android:textColor="@color/black"
                android:textSize="15sp" />


            <CheckBox
                android:id="@+id/ch_multi_33kv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=" 33 KV Multi Circuits"
                android:fontFamily="@font/inter"
                android:layout_marginTop="16dp"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/feeder_33"
                android:visibility="gone"
                >

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="4dp"
                    android:text="Select Feeder"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/red1"/>

                <Spinner
                    android:id="@+id/sp_feeder_33"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/ddimg"
                    />



            </LinearLayout>

            <CheckBox
                android:id="@+id/ch_multi_11kv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=" 11/6.3 KV Multi Circuits"
                android:fontFamily="@font/inter"
                android:layout_marginTop="10dp"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/feeder_11"
                android:visibility="gone"
                >

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="4dp"
                    android:text="Select Feeder"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/red1"/>

                <Spinner
                    android:id="@+id/sp_feeder_11"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/ddimg"
                    />



            </LinearLayout>

            <CheckBox
                android:id="@+id/ch_multi_lt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=" LT Multi Circuits"
                android:fontFamily="@font/inter"
                android:layout_marginTop="10dp"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/feeder_lt"
                android:visibility="gone"
                >

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="4dp"
                    android:text="Select LT Circuit"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/red1"/>

                <Spinner
                    android:id="@+id/sp_feeder_lt"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/ddimg"
                    />



            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/dialog_cancel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button_background"
                    android:backgroundTint="@color/redred"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="CANCEL"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/back_to_home"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button_background"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="LOAD MAP"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:textStyle="bold" />



            </LinearLayout>

        </LinearLayout>

    </ScrollView>




</LinearLayout>