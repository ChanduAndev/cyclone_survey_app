                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/ddimg"
                android:entries="@array/straight_rmu" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lay_ug_line_capacitor"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:text="Line Capacitor Work Condition :"
                android:textColor="@color/red" />

            <Spinner
                android:id="@+id/sp_ug_line_capacitor"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/ddimg"
                android:entries="@array/ug_line_capacitor" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lay_ug_auto_reclosure"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:text="Auto Reclosure Type:"
                android:textColor="@color/red" />

            <Spinner
                android:id="@+id/sp_ug_auto_reclosure"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/ddimg"
                android:entries="@array/pc_auto_reclosure" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lay_ug_no_of_ab_switches"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:text="No of AB Switches:"
                android:textColor="@color/red" />

            <Spinner
                android:id="@+id/sp_ug_no_of_ab_switches"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/ddimg"
                android:entries="@array/oh_no_of_ab_switches" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lay_ug_ht_service_number"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:text="HT Service Number :"
                android:textColor="@color/red" />

            <AutoCompleteTextView
                android:id="@+id/auto_ug_ht_service_number"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lyt_rmu"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:text="RMU* :"
                android:textColor="@color/red" />

            <Spinner
                android:id="@+id/sp_rmu"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/ddimg"
                android:entries="@array/rmu" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lyt_underpolestructure"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:text="Type Of Structure* :"
                android:textColor="@color/red" />

            <Spinner
                android:id="@+id/sp__underpolestructure"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/ddimg"
                android:entries="@array/undergpole_structure" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lyt_ugpole"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:padding="4dp"
                    android:text="Pole Type* :"
                    android:textColor="@color/red" />

                <Spinner
                    android:id="@+id/sp_ugpoletype"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ddimg"
                    android:entries="@array/ugpole_type" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:padding="4dp"
                    android:text="Pole Height* :"
                    android:textColor="@color/red" />


                <Spinner
                    android:id="@+id/sp_ugpoleheight"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ddimg"
                    android:entries="@array/pole_height" />
            </LinearLayout>

            <!--    <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:padding="4dp"
                        android:text="Strut/Stay details* :"
                        android:textColor="@color/red" />

                    <Spinner
                        android:id="@+id/sp_ug_struct_stay_detailes"
                        android:layout_width="fill_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/ddimg"
                        android:entries="@array/ug_struct_stay" />

                </LinearLayout>-->

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:padding="4dp"
                    android:text="PoleSupport* :"
                    android:textColor="@color/red" />

                <Spinner
                    android:id="@+id/sp_ugpolesupport"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ddimg"
                    android:entries="@array/ugpole_support" />
            </LinearLayout>


        </LinearLayout>
        <!--<LinearLayout
            android:id="@+id/lyt_ugssname"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:orientation="vertical">
            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:text="SS Name* :"
                android:textColor="@color/red"/>

            <Spinner
                android:id="@+id/sp_ugssname"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/ddimg"
                android:entries="@array/pole_configuration" />

        </LinearLayout>-->

        <LinearLayout
            android:id="@+id/lay_ug_dtr_pole_main"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:padding="4dp"
                    android:text="Section Name :"
                    android:textColor="@color/red" />

                <Spinner
                    android:id="@+id/sp_ug_section_name_dtr_pole"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ddimg" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:padding="4dp"
                    android:text="DTR Code:"
                    android:textColor="@color/red" />

                <AutoCompleteTextView
                    android:id="@+id/auto_ug_dtr_structure_dtr_pole"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:padding="4dp"
                    android:text="DTR Structure Type :"
                    android:textColor="@color/red" />

                <Spinner
                    android:id="@+id/sp_ug_dtr_structure_type_dtr_pole"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ddimg"
                    android:entries="@array/dtr_structure_type_dtr_pole" />
            </LinearLayout>




            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
