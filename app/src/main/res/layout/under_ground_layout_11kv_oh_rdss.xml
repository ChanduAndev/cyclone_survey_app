                    android:padding="4dp"
                    android:text="Is DTR available ?:"
                    android:textColor="@color/red" />

                <Spinner
                    android:id="@+id/sp_ug_is_dtr_avalabile"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ddimg"
                    android:entries="@array/oh_is_dtr_avalable" />
            </LinearLayout>

            <LinearLayout
