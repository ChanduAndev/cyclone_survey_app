                android:textColor="@color/red"/>
            <Spinner
                android:id="@+id/sp_ug_wosurveycompleted"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/ddimg"
                android:entries="@array/is_wosurvey_completed" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:text="No.Of Cables* :"
                android:textColor="@color/red" />

            <Spinner
                android:id="@+id/sp_noofcircuit_underg"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/ddimg"
                android:entries="@array/noof_circuit" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
