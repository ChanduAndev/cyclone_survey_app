                        android:textColor="@color/red" />

                    <EditText
                        android:id="@+id/ed_ug_serial_number_dtr_pole"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:lines="1"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:padding="4dp"
                        android:text="Location Name:"
                        android:textColor="@color/red" />

                    <EditText
                        android:id="@+id/ed_ug_location_name_dtr_pole"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:padding="4dp"
                        android:text="Type of Load:"
                        android:textColor="@color/red" />

                    <Spinner
                        android:id="@+id/sp_ug_type_of_load"
                        android:layout_width="fill_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/ddimg"
                        android:entries="@array/ug_type_of_load" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:padding="4dp"
                        android:text="DTR Location type:"
                        android:textColor="@color/red" />

                    <Spinner
                        android:id="@+id/sp_ug_dtr_location_type"
                        android:layout_width="fill_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/ddimg"
                        android:entries="@array/ug_dtr_location_type" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:padding="4dp"
                        android:text="Is LT ckts available :"
                        android:textColor="@color/red" />

                    <Spinner
                        android:id="@+id/sp_ug_is_lt_ckts_available"
                        android:layout_width="fill_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/ddimg"
                        android:entries="@array/ug_lt_ckts_avalable" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/lay_ug_no_of_lt_circuits"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:padding="4dp"
                        android:text="No of LT circuits:"
                        android:textColor="@color/red" />

                    <Spinner
                        android:id="@+id/sp_ug_no_of_lt_circuits"
                        android:layout_width="fill_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/ddimg"
                        android:entries="@array/ug_of_lt_circuit" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:padding="4dp"
                        android:text="AB Switch Available:"
                        android:textColor="@color/red" />

                    <Spinner
                        android:id="@+id/sp_ug_ab_switch_dtr_pole"
                        android:layout_width="fill_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/ddimg"
                        android:entries="@array/ab_switch_dtr_pole" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="4dp"
                android:text="Tapping Point* :"
                android:textColor="@color/red" />

            <Spinner
                android:id="@+id/sp_ugtapingpoint"
                android:layout_width="fill_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/ddimg"
                android:entries="@array/taping_point" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lyt_ugtapping"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:padding="4dp"
