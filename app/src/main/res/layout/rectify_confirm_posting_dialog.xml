<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/button_background"
    android:backgroundTint="@color/white"
    android:layout_marginLeft="2dp"
    android:layout_marginRight="2dp"
    android:paddingHorizontal="15dp"
    android:paddingVertical="5dp"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">



    <!-- Image Scanner Frame -->
    <ImageView
        android:layout_marginTop="10dp"
        android:id="@+id/taken_image"
        android:layout_width="240dp"
        android:layout_height="200dp"
        android:scaleType="fitXY"
        android:background="@drawable/bg_frame"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:fontFamily="@font/abeezee"
        android:paddingTop="5dp"
        android:text="AI VERIFICATION RESULT"
        android:textAllCaps="true"
        android:textStyle="bold"
        android:textColor="@color/new_color"
        android:textSize="17sp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/adapter_border"
        android:layout_marginTop="10dp"
        >

        <RelativeLayout
            android:visibility="gone"
            android:id="@+id/ai_pole_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="3dp"
            android:paddingHorizontal="8dp"
           >

            <TextView
                android:layout_alignParentLeft="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:gravity="start"
                android:fontFamily="@font/abeezee"
                android:text="Pole"
                android:textStyle="normal"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <TextView
                android:layout_alignParentRight="true"
                android:id="@+id/ai_pole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:gravity="end"
                android:fontFamily="@font/abeezee"
                android:text="Pole"
                android:textStyle="normal"
                android:textColor="@color/black"
                android:textSize="13sp" />



        </RelativeLayout>

        <View
            android:id="@+id/view_cross_arm"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:background="@color/colorPrimary"
            />

        <RelativeLayout
            android:paddingVertical="3dp"
            android:paddingHorizontal="8dp"
            android:visibility="gone"
            android:id="@+id/ai_cross_arm_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <TextView
                android:layout_alignParentLeft="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:gravity="start"
                android:fontFamily="@font/abeezee"
                android:text="Cross Arm"
                android:textStyle="normal"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <TextView
                android:layout_alignParentRight="true"
                android:id="@+id/ai_cross_arm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:gravity="end"
                android:fontFamily="@font/abeezee"
                android:text="Pole"
                android:textStyle="normal"
                android:textColor="@color/black"
                android:textSize="13sp" />

        </RelativeLayout>

        <View
            android:id="@+id/view_top_cleat"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:background="@color/colorPrimary"
            />

        <RelativeLayout
            android:paddingVertical="3dp"
            android:paddingHorizontal="8dp"
            android:visibility="gone"
            android:id="@+id/ai_top_cleat_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <TextView
                android:layout_alignParentLeft="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:gravity="start"
                android:fontFamily="@font/abeezee"
                android:text="Top Cleat"
                android:textStyle="normal"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <TextView
                android:layout_alignParentRight="true"
                android:id="@+id/ai_top_cleat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:gravity="end"
                android:fontFamily="@font/abeezee"
                android:text="Pole"
                android:textStyle="normal"
                android:textColor="@color/black"
                android:textSize="13sp" />

        </RelativeLayout>

        <View
            android:id="@+id/view_others"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:background="@color/colorPrimary"
            />

        <RelativeLayout
            android:paddingVertical="3dp"
            android:paddingHorizontal="8dp"
            android:visibility="gone"
            android:id="@+id/ai_others_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <TextView
                android:layout_alignParentLeft="true"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:layout_gravity="start"
                android:gravity="start"
                android:fontFamily="@font/abeezee"
                android:text="Others"
                android:textStyle="normal"
                android:textColor="@color/black"
                android:textSize="13sp" />

            <TextView
                android:layout_alignParentRight="true"
                android:id="@+id/ai_others"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:gravity="end"
                android:fontFamily="@font/abeezee"
                android:text="Pole"
                android:textStyle="normal"
                android:textColor="@color/black"
                android:textSize="13sp" />

        </RelativeLayout>

    </LinearLayout>



    <TextView
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:fontFamily="@font/abeezee"
        android:text="The above rectifications were identified by AI after analyzing the image. Are you sure you want to transmit the results?"
        android:textStyle="normal"
        android:textColor="@color/lightGrey"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp"
        android:weightSum="2"
        >

        <TextView
            android:id="@+id/cancel_button"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:fontFamily="@font/abeezee"
            android:layout_margin="5dp"
            android:paddingVertical="7dp"
            android:background="@drawable/curve_border"
            android:backgroundTint="@color/redred"
            android:text="Cancel"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/proceed_button"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:fontFamily="@font/abeezee"
            android:layout_margin="5dp"
            android:paddingVertical="7dp"
            android:background="@drawable/curve_border"
            android:backgroundTint="@color/colorPrimary"
            android:text="Transmit"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="15sp" />

    </LinearLayout>







</LinearLayout>