<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F9F8F9">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimary"
                android:padding="15dp">

                <RelativeLayout
                    android:id="@+id/ivLogo"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentStart="true"
                    android:background="@drawable/round_boarder"
                    android:backgroundTint="#DBE4FF">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/new_logo"
                        android:layout_centerVertical="true"
                        android:layout_centerHorizontal="true"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>



                <ImageView
                    android:id="@+id/profile_layout_new"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_baseline_person_24"
                    android:background="@drawable/round_boarder"
                    android:padding="7dp"
                    app:tint="@color/colorPrimary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:layout_toRightOf="@id/ivLogo"
                    android:layout_marginLeft="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="APEPDCL GIS"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Field Survey App"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/white" />
                </LinearLayout>
            </RelativeLayout>





            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_margin="15dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <com.denzcoskun.imageslider.ImageSlider
                    android:id="@+id/image_slider"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:iss_auto_cycle="true"
                    app:iss_delay="1000"
                    app:iss_period="1000"
                    app:iss_selected_dot="@drawable/default_selected_dot"
                    app:iss_text_align="CENTER"
                    app:iss_unselected_dot="@drawable/default_unselected_dot"
                    />
            </androidx.cardview.widget.CardView>


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginVertical="8dp"
                >

                <TextView
                    android:id="@+id/tvSurveyModules"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Survey Modules"
                    android:fontFamily="@font/inter"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text=""
                    android:fontFamily="@font/inter"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#4A6CF7" />
            </RelativeLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:weightSum="2">

                <androidx.cardview.widget.CardView
                    android:id="@+id/rdssCard_new"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_weight="1"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="16dp"
                    app:cardUseCompatPadding="true"
                    app:strokeWidth="3dp"
                    app:strokeColor="#33FFFFFF"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:id="@+id/rdss"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center"

                        >

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/adapter_border"
                            android:padding="7dp"
                            android:backgroundTint="#FFF1F2"
                            android:src="@drawable/rdss_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RDSS Asset Survey"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:layout_marginTop="8dp" />


                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/web_gis_rdss"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_weight="1"
                    app:cardElevation="3dp"
                    app:cardCornerRadius="16dp"
                    app:cardUseCompatPadding="true"
                    app:strokeWidth="3dp"
                    app:strokeColor="#33FFFFFF"
                    app:cardBackgroundColor="@color/white">
                    <LinearLayout
                        android:id="@+id/profile_grid"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center"

                        >

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/adapter_border"
                            android:padding="7dp"
                            android:backgroundTint="#EEEEEE"
                            android:src="@drawable/web_gis_icon"
                            app:tint="@color/black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Web GIS"
                            android:textStyle="bold"
                            android:fontFamily="@font/inter"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:layout_marginTop="8dp" />


                    </LinearLayout>
                </androidx.cardview.widget.CardView>





            </LinearLayout>









        </LinearLayout>

    </ScrollView>

    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/loader_new_rdss"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:visibility="gone"
        android:layout_centerInParent="true"
        android:src="@drawable/loader_new"
        />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/two_sides_rounded_border_up"
        android:backgroundTint="@color/light_gray_clor_2"
        android:padding="3dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/inter"
            android:text="@string/powerby"
            android:textColor="@color/ui_black_color"
            android:textStyle="bold"
            android:textSize="12sp"/>
    </RelativeLayout>


</RelativeLayout>
