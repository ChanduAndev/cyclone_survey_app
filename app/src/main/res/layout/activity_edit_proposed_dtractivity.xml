<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_toolbar_gradient"
    tools:context="com.apepdcl.gis_survey.estimates.sou.EditProposedDTRActivity">

    <LinearLayout
        android:id="@+id/loader_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:text="PLEASE WAIT..."
            android:textColor="@color/red1"
            android:textSize="16dp" />


    </LinearLayout>

    <RelativeLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp">


        <RelativeLayout
            android:id="@+id/back_layout"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentLeft="true"
            android:layout_centerInParent="true"
            android:layout_marginLeft="15dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/round_boarder">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_arrow_back_black_24dp"
                app:tint="@color/new_color" />


        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:layout_toLeftOf="@+id/close_layout"
            android:layout_toRightOf="@id/back_layout">

            <TextView
                android:id="@+id/home_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/inter"
                android:paddingTop="5dp"
                android:text="Edit DTR Particulurs"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/close_layout"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/round_boarder">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_baseline_close_24"
                app:tint="@color/new_color" />

        </RelativeLayout>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/layout_bottom_version"
        android:background="@drawable/tool_bar_bg"
        android:layout_below="@id/header_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="5dp">

            <LinearLayout
                android:id="@+id/layout_dtr_phase_11kv"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Proposed DTR Phase*"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/sp_dtr_phase_11"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:popupBackground="@drawable/spinner_dropdown_bg"
                android:background="@drawable/bg_spinner_field" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_dtr_capacity"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Proposed DTR Capacity*"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/sp_dtr_capacity_phase1_11"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:popupBackground="@drawable/spinner_dropdown_bg"
                android:background="@drawable/bg_spinner_field"
                    android:entries="@array/dtr_phase1_capacity_11kv"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/sp_dtr_capacity_phase2_11"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:popupBackground="@drawable/spinner_dropdown_bg"
                android:background="@drawable/bg_spinner_field"
                    android:entries="@array/dtr_phase2_capacity_11kv"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_dtr_material"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tv_sp_pole_desc_11"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="DTR Material"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/sp_dtr_material_11"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:popupBackground="@drawable/spinner_dropdown_bg"
                android:background="@drawable/bg_spinner_field" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_dtr_location_11kv"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Proposed DTR Location*"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/dtr_location_name"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/distance_boarder_2"
                    android:hint="Enter DTR Location Name"
                    android:maxLength="200"
                    android:padding="10dp"
                    android:textSize="15dp"
                    tools:text="hello" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_dtr_mounting"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tv_dtr_mounting_11kv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Proposed DTR Mounting*"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/sp_dtr_mounting_11"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:popupBackground="@drawable/spinner_dropdown_bg"
                android:background="@drawable/bg_spinner_field"
                    android:entries="@array/dtr_mounting_11kv" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_dtr_apartment_11kv"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tv_lt_available"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Is LT Circuit Available?*"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/sp_dtr_apartment_11"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:popupBackground="@drawable/spinner_dropdown_bg"
                android:background="@drawable/bg_spinner_field" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_no_of_lt_circuits_11"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="No of LT Circuits*"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/sp_no_of_lt_circuits_11"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:popupBackground="@drawable/spinner_dropdown_bg"
                android:background="@drawable/bg_spinner_field" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_meter_11kv"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Is Meter connected to DTR without LT Pole*"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/sp_meter_available_11"
                    android:layout_width="fill_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:popupBackground="@drawable/spinner_dropdown_bg"
                android:background="@drawable/bg_spinner_field"
                    android:entries="@array/meter_available_estimates" />
            </LinearLayout>



            <TextView
                android:id="@+id/btn_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_gradient"
                android:fontFamily="@font/inter"
                android:padding="8dp"
                android:gravity="center"
                android:text="Update"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <RelativeLayout
        android:id="@+id/layout_bottom_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/two_sides_rounded_border_up"
        android:backgroundTint="@color/light_gray_clor_2"
        android:padding="3dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/inter"
            android:text="@string/powerby"
            android:textColor="@color/ui_black_color"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>


</RelativeLayout>