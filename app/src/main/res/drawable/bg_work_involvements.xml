<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#EAF3FF"/>

    <!-- Border -->
    <stroke
        android:width="2dp"
        android:color="#2979FF"/>

    <!-- Rounded corners -->
    <corners android:radius="6dp"/>

    <!-- Inner padding -->
    <padding
        android:left="12dp"
        android:top="10dp"
        android:right="12dp"
        android:bottom="10dp"/>
</shape>