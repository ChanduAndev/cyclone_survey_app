<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#F8F8F8"/>

    <!-- Border -->
    <stroke
        android:width="0.5dp"
        android:color="@color/ui_black_color"/>

    <!-- Rounded corners -->
    <corners android:radius="6dp"/>

    <!-- Inner padding -->
    <padding
        android:left="12dp"
        android:top="10dp"
        android:right="12dp"
        android:bottom="10dp"/>
</shape>